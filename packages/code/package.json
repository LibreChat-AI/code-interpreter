{
  "name": "@librechat/code",
  "version": "0.1.0-rc.1",
  "description": "LibreChat stateful code environment protocol and worker CLI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./browser-enrollment": {
      "types": "./dist/browser-enrollment-protocol.d.ts",
      "import": "./dist/browser-enrollment-protocol.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./workspace-runtime": {
      "types": "./dist/workspace-runtime.d.ts",
      "import": "./dist/workspace-runtime.js"
    },
    "./native-sandbox": {
      "types": "./dist/native-sandbox.d.ts",
      "import": "./dist/native-sandbox.js"
    },
    "./native-policy": {
      "types": "./dist/native-policy.d.ts",
      "import": "./dist/native-policy.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "import": "./dist/github.js"
    }
  },
  "bin": {
    "lc-code": "./dist/cli.js",
    "librechat-code": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "!dist/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.21"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "koffi": "3.2.1",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LibreChat-AI/code-interpreter.git",
    "directory": "packages/code"
  },
  "homepage": "https://github.com/LibreChat-AI/code-interpreter/tree/main/packages/code",
  "bugs": {
    "url": "https://github.com/LibreChat-AI/code-interpreter/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
