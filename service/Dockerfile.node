# Base stage for shared steps
FROM oven/bun:1.4.4 AS dependency-tool
FROM node:22.23.4-slim AS base
COPY --from=dependency-tool /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY service/package.json service/bun.lock ./
COPY service/patches ./patches
RUN bun install --frozen-lockfile

# Build stage
FROM base AS builder
COPY service/src ./src
COPY shared /shared
COPY packages/code/src /packages/code/src
COPY service/tsconfig.json ./
RUN npx tsc -p tsconfig.json

# Production stage
FROM node:22.23.4-slim AS production
COPY --from=dependency-tool /usr/local/bin/bun /usr/local/bin/bun
ENV NODE_ENV=production
WORKDIR /app
COPY service/package.json service/bun.lock ./
COPY service/patches ./patches
RUN bun install --frozen-lockfile --production
COPY --from=builder /app/.build ./.build
EXPOSE 3000
CMD ["node", ".build/file-server.js"]

# Development stage
FROM base AS development
ENV NODE_ENV=development
COPY service/src ./src
COPY shared /shared
COPY packages/code/src /packages/code/src
COPY service/tsconfig.json ./
RUN npm install -g ts-node typescript
EXPOSE 3000 9230
CMD ["npm", "run", "debug:minio"]
